{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskRat",
  "version": "1.0.1",
  "identifier": "io.github.konstantinushakov.deskrat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1433",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "DeskRat — noncommercial fork of DeskPartner",
    "publisher": "DeskRat",
    "copyright": "© 2026 Forecastych. PolyForm Noncommercial 1.0.0",
    "category": "Utility",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE"
    }
  },
  "plugins": {},
  "mainBinaryName": "deskrat"
}
